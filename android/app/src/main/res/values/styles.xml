<?xml version="1.0" encoding="utf-8"?>
<!--
    El app es de tema oscuro fijo, así que los estilos de día y de noche son
    iguales: el fondo violeta oscuro desde el primer milisegundo.
-->
<resources>
    <!-- Tema de la ventana mientras arranca el proceso -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Tema de la ventana ya arrancado el proceso; también es el fondo
         detrás de la UI de Flutter mientras inicializa. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
