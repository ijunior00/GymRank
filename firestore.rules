rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function callerRole() {
      return isSignedIn() ? callerDoc().role : null;
    }

    function callerCoachId() {
      let doc = callerDoc();
      return ('coachId' in doc) ? doc.coachId : null;
    }

    function isAdmin() {
      return isSignedIn() && callerRole() == 'adminGlobal';
    }

    // A treinadora dona de `coaches/{coachId}`: papel `coach` e o próprio
    // perfil apontando para esse painel.
    function isCoachOf(coachId) {
      return isSignedIn() && callerRole() == 'coach' && callerCoachId() == coachId;
    }

    // Nutrióloga parceira vinculada ao mesmo painel (leitura da comunidade;
    // a parte alimentar ganha regras próprias quando existir).
    function isNutriologoOf(coachId) {
      return isSignedIn() && callerRole() == 'nutriologo' && callerCoachId() == coachId;
    }

    function isCoachStaffOf(coachId) {
      return isCoachOf(coachId) || isNutriologoOf(coachId) || isAdmin();
    }

    // Campos que só podem ser alterados pelo backend (Cloud Functions com
    // Admin SDK, que ignora estas regras). Impede que o cliente forje XP,
    // nível, Gym Score ou o próprio papel.
    function onlyProfileFieldsChanged() {
      let unchangeable = ['xpTotal', 'xpCurrentSeason', 'level', 'gymScore',
        'currentStreakDays', 'longestStreakDays', 'lastCheckInAt', 'role',
        'plan', 'createdAt', 'referralCount', 'referredBy'];
      return !unchangeable.toSet().hasAny(request.resource.data.diff(resource.data).affectedKeys());
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      // Todo cadastro nasce como alumno; coach/nutriologo/adminGlobal são
      // atribuídos fora do app (console ou script com Admin SDK).
      allow create: if isOwner(userId) && request.resource.data.role == 'alumno';
      allow update: if isOwner(userId) && onlyProfileFieldsChanged();
      allow delete: if false;

      match /achievements/{code} {
        allow read: if isSignedIn();
        allow write: if false; // Cloud Functions only
      }

      match /fcmTokens/{token} {
        allow read, write: if isOwner(userId);
      }
    }

    match /coaches/{coachId} {
      allow read: if isSignedIn();
      // A própria treinadora cria seu perfil de marca uma única vez (o
      // papel `coach` já precisa existir no perfil dela).
      allow create: if isSignedIn() &&
        callerRole() == 'coach' &&
        callerCoachId() == null &&
        request.resource.data.ownerUserId == request.auth.uid;
      allow update: if isCoachOf(coachId) || isAdmin();
      allow delete: if isAdmin();

      match /stats/{statId} {
        allow read: if isCoachStaffOf(coachId);
        allow write: if false; // Cloud Functions only
      }

      // Vínculo aluno <-> treinadora.
      match /clients/{userId} {
        allow read: if isOwner(userId) || isCoachStaffOf(coachId);
        // O aluno entra pelo código de convite (sempre como `activo`); a
        // treinadora pode cadastrar manualmente.
        allow create: if isCoachOf(coachId) || isAdmin() ||
          (isOwner(userId) &&
            request.resource.data.userId == userId &&
            request.resource.data.coachId == coachId &&
            request.resource.data.status == 'activo');
        allow update, delete: if isCoachOf(coachId) || isAdmin();

        // Notas privadas da treinadora: o aluno nunca lê.
        match /notes/{noteId} {
          allow read, create, update, delete: if isCoachOf(coachId) || isAdmin();
        }
      }

      match /checkins/{checkInId} {
        allow read: if isOwner(resource.data.userId) || isCoachStaffOf(coachId);
        allow write: if false; // Cloud Function validateCheckIn only
      }
    }

    // Arquivos (PDF/Word/foto) enviados pela treinadora ou nutrióloga para
    // um aluno, com o resultado da leitura automática. O aluno vê os
    // metadados; só o staff da comunidade cria/edita.
    match /documents/{docId} {
      allow read: if isSignedIn() &&
        (isOwner(resource.data.userId) || isCoachStaffOf(resource.data.coachId));
      allow create: if isCoachStaffOf(request.resource.data.coachId) &&
        request.resource.data.uploadedBy == request.auth.uid &&
        request.resource.data.status == 'subido';
      allow update: if isCoachStaffOf(resource.data.coachId);
      allow delete: if isCoachOf(resource.data.coachId) || isAdmin();
    }

    // Plano vigente de um aluno por tipo + histórico imutável de versões.
    match /plans/{planId} {
      allow read: if isSignedIn() &&
        (isOwner(resource.data.userId) || isCoachStaffOf(resource.data.coachId));
      allow create, update: if isCoachStaffOf(request.resource.data.coachId);
      allow delete: if isCoachOf(resource.data.coachId) || isAdmin();

      match /versions/{versionNumber} {
        allow read: if isSignedIn() &&
          (isOwner(resource.data.userId) || isCoachStaffOf(resource.data.coachId));
        allow create: if isCoachStaffOf(request.resource.data.coachId);
        allow update, delete: if false; // append-only
      }
    }

    // Sessão de treino executada a partir do plano. O aluno cria e edita
    // enquanto está `enCurso` e a encerra; validação, XP, sequência e
    // recordes são da Cloud Function `onWorkoutSessionCompleted`.
    match /workout_sessions/{sessionId} {
      allow read: if isSignedIn() &&
        (isOwner(resource.data.userId) || isCoachStaffOf(resource.data.coachId));
      allow create: if isOwner(request.resource.data.userId) &&
        request.resource.data.status == 'enCurso' &&
        !request.resource.data.keys().hasAny(
          ['validated', 'validationReason', 'prs', 'countedForStreak', 'xpGranted']);
      allow update: if isOwner(resource.data.userId) &&
        resource.data.status == 'enCurso' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['validated', 'validationReason', 'prs', 'countedForStreak', 'xpGranted',
           'userId', 'coachId', 'planId', 'startedAt', 'createdAt']);
      allow delete: if false;
    }

    // Card compartilhado por um aluno: alimenta o painel da treinadora
    // com o que está circulando. Só o autor cria; ninguém edita depois.
    match /share_cards/{cardId} {
      allow read: if isSignedIn() &&
        (isOwner(resource.data.userId) || isCoachStaffOf(resource.data.coachId));
      allow create: if isOwner(request.resource.data.userId);
      allow update: if false;
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Refeição do plano marcada como hecha / cambiada / saltada.
    match /meal_logs/{logId} {
      allow read: if isSignedIn() &&
        (isOwner(resource.data.userId) || isCoachStaffOf(resource.data.coachId));
      allow create: if isOwner(request.resource.data.userId) &&
        logId == request.resource.data.userId + '_' + request.resource.data.date + '_' +
          string(request.resource.data.mealIndex);
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /workouts/{workoutId} {
      allow read: if isSignedIn();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /body_measurements/{measurementId} {
      allow read: if isSignedIn();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if false; // histórico imutável
    }

    match /progress_photos/{photoId} {
      allow read: if isSignedIn();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if false;
      allow delete: if isOwner(resource.data.userId);
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['text']);
      allow delete: if isOwner(resource.data.userId) || isAdmin();

      match /likes/{userId} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(userId);
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isOwner(request.resource.data.userId);
        allow delete: if isOwner(resource.data.userId) || isAdmin();
        allow update: if false;
      }
    }

    match /friendships/{friendshipId} {
      allow read: if isSignedIn() &&
        (resource.data.requesterId == request.auth.uid ||
         resource.data.addresseeId == request.auth.uid);
      allow create: if isOwner(request.resource.data.requesterId);
      allow update: if isSignedIn() &&
        (resource.data.requesterId == request.auth.uid ||
         resource.data.addresseeId == request.auth.uid);
      allow delete: if false;
    }

    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create, update: if isCoachOf(request.resource.data.coachId) || isAdmin();
      allow delete: if isCoachOf(resource.data.coachId) || isAdmin();

      match /participants/{userId} {
        allow read: if isSignedIn();
        // Cliente só cria a inscrição inicial; progresso e conclusão são
        // calculados por Cloud Functions a partir de dados de origem
        // confiável (check-ins, treinos), nunca auto-declarados.
        allow create: if isOwner(userId) &&
          request.resource.data.currentValue == 0 &&
          request.resource.data.completed == false;
        allow update, delete: if false;
      }
    }

    match /championships/{championshipId} {
      allow read: if isSignedIn();
      allow create, update: if isCoachOf(request.resource.data.coachId) || isAdmin();
      allow delete: if isCoachOf(resource.data.coachId) || isAdmin();
    }

    match /rewards/{rewardId} {
      allow read: if isSignedIn();
      allow create, update: if isCoachOf(request.resource.data.coachId) || isAdmin();
      allow delete: if isCoachOf(resource.data.coachId) || isAdmin();

      match /grants/{grantId} {
        allow read: if isOwner(resource.data.userId) || isAdmin();
        allow write: if false; // Cloud Functions only
      }
    }

    match /rankings/{rankingId} {
      allow read: if isSignedIn();
      allow write: if false; // Cloud Functions only

      match /entries/{userId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false; // Cloud Functions only
    }

    match /gym_score_history/{entryId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false; // Cloud Functions only
    }

    match /seasons/{seasonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /results/{userId} {
        allow read: if isSignedIn();
        allow write: if false; // Cloud Function seasonReset only
      }
    }
  }
}
