rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function callerRole() {
      return isSignedIn() ? callerDoc().role : null;
    }

    function callerCoachId() {
      let doc = callerDoc();
      return ('coachId' in doc) ? doc.coachId : null;
    }

    function isAdmin() {
      return isSignedIn() && callerRole() == 'adminGlobal';
    }

    // A treinadora dona de `coaches/{coachId}`: papel `coach` e o próprio
    // perfil apontando para esse painel. O `coachId != null` importa: sem
    // ele, uma coach que ainda não criou a comunidade (coachId nulo)
    // "bateria" com qualquer aluna sem treinadora (coachId nulo também).
    function isCoachOf(coachId) {
      return isSignedIn() && coachId != null &&
        callerRole() == 'coach' && callerCoachId() == coachId;
    }

    // Nutrióloga parceira vinculada ao mesmo painel (leitura da comunidade;
    // a parte alimentar ganha regras próprias quando existir).
    function isNutriologoOf(coachId) {
      return isSignedIn() && coachId != null &&
        callerRole() == 'nutriologo' && callerCoachId() == coachId;
    }

    function isCoachStaffOf(coachId) {
      return isCoachOf(coachId) || isNutriologoOf(coachId) || isAdmin();
    }

    // Treinadora de uma aluna, lida do perfil dela.
    function coachIdOfUser(userId) {
      let u = get(/databases/$(database)/documents/users/$(userId)).data;
      return ('coachId' in u) ? u.coachId : null;
    }

    // Dado pessoal da aluna (treino, medida, foto): só ela e o staff da
    // comunidade dela. Numa consulta com `userId == X` o motor de regras
    // sabe o valor de `resource.data.userId`, então consegue buscar o
    // perfil e avaliar — é o que deixa a coach listar sem que cada
    // registro precise carregar `coachId`. O `||` para no primeiro
    // verdadeiro: a própria aluna nunca paga a busca extra.
    function isOwnerOrStaffOfUser(userId) {
      return isOwner(userId) || isCoachStaffOf(coachIdOfUser(userId));
    }

    // Carimbo de tempo dentro de uma janela em torno de agora. Fecha a
    // porta de "registrar" 30 treinos com datas no passado num só dia.
    function recentTs(ts, past, future) {
      return ts is timestamp && ts > request.time - past && ts < request.time + future;
    }

    function validText(text, max) {
      return text is string && text.size() > 0 && text.size() <= max;
    }

    // Campo opcional: ausente, nulo, ou texto dentro do limite.
    function optionalText(data, key, max) {
      return data.get(key, null) == null || validText(data[key], max);
    }

    // Ponto de check-in (academia) com QR impresso. Raio entre 50 m e 1 km:
    // menos que isso o GPS de celular não distingue; mais, não é "estar lá".
    function validLocation(d) {
      return validText(d.name, 80) &&
        optionalText(d, 'address', 200) &&
        d.lat is number && d.lat >= -90 && d.lat <= 90 &&
        d.lng is number && d.lng >= -180 && d.lng <= 180 &&
        d.radiusM is number && d.radiusM >= 50 && d.radiusM <= 1000 &&
        d.qrVersion is int && d.qrVersion >= 1 &&
        d.active is bool;
    }

    // Quem pode ler um plano, decidido pelo documento pai buscado pelo
    // CAMINHO (não por campos do documento lido). Isso importa para as
    // subcoleções: uma consulta em `plans/{id}/versions` não tem como
    // provar nada sobre `resource.data`, então uma regra baseada nela
    // recusa a lista inteira — regras não filtram, recusam.
    function canReadPlan(planId) {
      let plan = get(/databases/$(database)/documents/plans/$(planId)).data;
      return isOwner(plan.userId) || isCoachStaffOf(plan.coachId);
    }

    // Campos que só podem ser alterados pelo backend (Cloud Functions com
    // Admin SDK, que ignora estas regras). Impede que o cliente forje XP,
    // nível, Gym Score ou o próprio papel.
    function onlyProfileFieldsChanged() {
      let unchangeable = ['xpTotal', 'xpCurrentSeason', 'level', 'gymScore',
        'currentStreakDays', 'longestStreakDays', 'lastCheckInAt', 'role',
        'plan', 'createdAt', 'referralCount', 'referredBy'];
      return !unchangeable.toSet().hasAny(request.resource.data.diff(resource.data).affectedKeys());
    }

    // O perfil completo (nascimento, sexo, altura, cidade, quem indicou) é
    // da própria pessoa e do staff da comunidade dela. O que o resto do
    // app precisa saber de alguém (nome, @, foto, nível) está em
    // `public_profiles/{uid}`, espelhado pela function `onUserWritten`.
    match /users/{userId} {
      allow read: if isOwner(userId) || isCoachStaffOf(resource.data.coachId);
      // Todo cadastro nasce como alumno; coach/nutriologo/adminGlobal são
      // atribuídos fora do app (console ou script com Admin SDK).
      allow create: if isOwner(userId) && request.resource.data.role == 'alumno';
      allow update: if isOwner(userId) && onlyProfileFieldsChanged();
      allow delete: if false;

      // Teto de XP por período: só a function `grantXp` escreve.
      match /xp_ledger/{bucket} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /achievements/{code} {
        allow read: if isSignedIn();
        allow write: if false; // Cloud Functions only
      }

      match /fcmTokens/{token} {
        allow read, write: if isOwner(userId);
      }
    }

    // Cartão público de cada pessoa: nome, @, foto, nível. É o que a busca
    // de amigas, a lista de amigas e o ranking mostram. Espelho de
    // `users/{uid}` mantido por Cloud Function; ninguém escreve pelo app.
    match /public_profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /coaches/{coachId} {
      allow read: if isSignedIn();
      // A própria treinadora cria seu perfil de marca uma única vez (o
      // papel `coach` já precisa existir no perfil dela). O segredo do QR
      // NÃO entra aqui: este documento é público para quem está logado.
      allow create: if isSignedIn() &&
        callerRole() == 'coach' &&
        callerCoachId() == null &&
        request.resource.data.ownerUserId == request.auth.uid &&
        !request.resource.data.keys().hasAny(['qrCodeSecret']);
      allow update: if (isCoachOf(coachId) || isAdmin()) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['qrCodeSecret', 'ownerUserId', 'studentCount', 'plan']);
      allow delete: if isAdmin();

      // Só o servidor: segredo do QR de check-in (`private/qr`). Quem
      // conseguisse lê-lo fabricaria check-ins válidos de casa.
      match /private/{docId} {
        allow read, write: if false;
      }

      // Academias onde a coach atende, cada uma com seu QR impresso. A
      // aluna não lê daqui (o servidor devolve o nome no check-in); a
      // assinatura do QR nunca fica gravada, sai da function na hora.
      match /locations/{locationId} {
        allow read: if isCoachStaffOf(coachId);
        allow create, update: if (isCoachOf(coachId) || isAdmin()) &&
          validLocation(request.resource.data);
        allow delete: if isCoachOf(coachId) || isAdmin();
      }

      match /stats/{statId} {
        allow read: if isCoachStaffOf(coachId);
        allow write: if false; // Cloud Functions only
      }

      // Vínculo aluno <-> treinadora.
      match /clients/{userId} {
        allow read: if isOwner(userId) || isCoachStaffOf(coachId);
        // O aluno entra pelo código de convite (sempre como `activo`); a
        // treinadora pode cadastrar manualmente.
        allow create: if isCoachOf(coachId) || isAdmin() ||
          (isOwner(userId) &&
            request.resource.data.userId == userId &&
            request.resource.data.coachId == coachId &&
            request.resource.data.status == 'activo');
        allow update, delete: if isCoachOf(coachId) || isAdmin();

        // Notas privadas da treinadora: o aluno nunca lê.
        match /notes/{noteId} {
          allow read, create, update, delete: if isCoachOf(coachId) || isAdmin();
        }
      }

      match /checkins/{checkInId} {
        allow read: if isOwner(resource.data.userId) || isCoachStaffOf(coachId);
        allow write: if false; // Cloud Function validateCheckIn only
      }
    }

    // Arquivos (PDF/Word/foto) enviados pela treinadora ou nutrióloga para
    // um aluno, com o resultado da leitura automática. O aluno vê os
    // metadados; só o staff da comunidade cria/edita.
    match /documents/{docId} {
      allow read: if isSignedIn() &&
        (isOwner(resource.data.userId) || isCoachStaffOf(resource.data.coachId));
      allow create: if isCoachStaffOf(request.resource.data.coachId) &&
        request.resource.data.uploadedBy == request.auth.uid &&
        request.resource.data.status == 'subido';
      allow update: if isCoachStaffOf(resource.data.coachId);
      allow delete: if isCoachOf(resource.data.coachId) || isAdmin();
    }

    // Plano vigente de um aluno por tipo + histórico imutável de versões.
    match /plans/{planId} {
      allow read: if isSignedIn() &&
        (isOwner(resource.data.userId) || isCoachStaffOf(resource.data.coachId));
      allow create, update: if isCoachStaffOf(request.resource.data.coachId);
      allow delete: if isCoachOf(resource.data.coachId) || isAdmin();

      match /versions/{versionNumber} {
        allow read: if isSignedIn() && canReadPlan(planId);
        allow create: if isCoachStaffOf(request.resource.data.coachId);
        allow update, delete: if false; // append-only
      }
    }

    // Sessão de treino executada a partir do plano. O aluno cria e edita
    // enquanto está `enCurso` e a encerra; validação, XP, sequência e
    // recordes são da Cloud Function `onWorkoutSessionCompleted`.
    // Os carimbos de início e fim têm de ser "agora" (com folga de relógio):
    // é o que faz uma sessão de 10 minutos levar 10 minutos de verdade. A
    // function ainda recalcula a duração a partir deles.
    match /workout_sessions/{sessionId} {
      allow read: if isSignedIn() &&
        (isOwner(resource.data.userId) || isCoachStaffOf(resource.data.coachId));
      allow create: if isOwner(request.resource.data.userId) &&
        request.resource.data.status == 'enCurso' &&
        recentTs(request.resource.data.startedAt, duration.value(10, 'm'), duration.value(10, 'm')) &&
        !request.resource.data.keys().hasAny(
          ['validated', 'validationReason', 'prs', 'countedForStreak', 'xpGranted']);
      allow update: if isOwner(resource.data.userId) &&
        resource.data.status == 'enCurso' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['validated', 'validationReason', 'prs', 'countedForStreak', 'xpGranted',
           'userId', 'coachId', 'planId', 'startedAt', 'createdAt']) &&
        (request.resource.data.status == 'enCurso' ||
          recentTs(request.resource.data.finishedAt, duration.value(10, 'm'), duration.value(10, 'm')));
      allow delete: if false;
    }

    // Card compartilhado por um aluno: alimenta o painel da treinadora
    // com o que está circulando. Só o autor cria; ninguém edita depois.
    match /share_cards/{cardId} {
      allow read: if isSignedIn() &&
        (isOwner(resource.data.userId) || isCoachStaffOf(resource.data.coachId));
      allow create: if isOwner(request.resource.data.userId);
      allow update: if false;
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Refeição do plano marcada como hecha / cambiada / saltada.
    match /meal_logs/{logId} {
      allow read: if isSignedIn() &&
        (isOwner(resource.data.userId) || isCoachStaffOf(resource.data.coachId));
      allow create: if isOwner(request.resource.data.userId) &&
        logId == request.resource.data.userId + '_' + request.resource.data.date + '_' +
          string(request.resource.data.mealIndex);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Treino registrado à mão ou gerado pelo servidor ao concluir uma
    // sessão. Cada criação rende XP (`onWorkoutCreated`), por isso a data
    // tem de ser de agora: nada de "registrar" o mês inteiro numa tarde.
    match /workouts/{workoutId} {
      allow read: if isOwnerOrStaffOfUser(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) &&
        recentTs(request.resource.data.date, duration.value(2, 'd'), duration.value(10, 'm')) &&
        request.resource.data.durationMinutes is number &&
        request.resource.data.durationMinutes >= 1 &&
        request.resource.data.durationMinutes <= 600 &&
        optionalText(request.resource.data, 'note', 500) &&
        // `sessionId` é o carimbo do servidor: só ele grava.
        !request.resource.data.keys().hasAny(['sessionId']);
      allow update: if isOwner(resource.data.userId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['userId', 'date', 'sessionId']) &&
        optionalText(request.resource.data, 'note', 500);
      allow delete: if isOwner(resource.data.userId);
    }

    match /body_measurements/{measurementId} {
      allow read: if isOwnerOrStaffOfUser(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) &&
        recentTs(request.resource.data.recordedAt, duration.value(7, 'd'), duration.value(10, 'm')) &&
        (request.resource.data.get('pesoKg', null) == null ||
          (request.resource.data.pesoKg is number &&
           request.resource.data.pesoKg > 20 && request.resource.data.pesoKg < 400)) &&
        (request.resource.data.get('percentualGordura', null) == null ||
          (request.resource.data.percentualGordura is number &&
           request.resource.data.percentualGordura >= 0 &&
           request.resource.data.percentualGordura <= 80));
      allow update, delete: if false; // histórico imutável
    }

    // Fotos de evolução: o dado mais sensível do app. Só a aluna e o staff
    // da comunidade dela — e o registro tem de apontar para um arquivo na
    // pasta dela no Storage, não para qualquer URL.
    match /progress_photos/{photoId} {
      allow read: if isOwnerOrStaffOfUser(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) &&
        recentTs(request.resource.data.takenAt, duration.value(1, 'd'), duration.value(10, 'm')) &&
        request.resource.data.storageUrl is string &&
        request.resource.data.storageUrl.matches(
          'https://firebasestorage[.]googleapis[.]com/v0/b/[^/]+/o/progress_photos%2F' +
          request.resource.data.userId + '%2F.*');
      allow update: if false;
      allow delete: if isOwner(resource.data.userId);
    }

    // Feed da comunidade. Os contadores de curtidas e comentários são do
    // servidor (`onLikeWritten`, `onCommentCreated`): o cliente só cria a
    // curtida e o comentário, cada um com dono e tamanho limitados.
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isOwner(request.resource.data.userId) &&
        validText(request.resource.data.text, 1000);
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['text']) &&
        validText(request.resource.data.text, 1000);
      allow delete: if isOwner(resource.data.userId) || isAdmin();

      match /likes/{userId} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(userId);
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isOwner(request.resource.data.userId) &&
          validText(request.resource.data.text, 500) &&
          request.resource.data.keys().hasOnly(
            ['postId', 'userId', 'authorName', 'authorPhotoUrl', 'text', 'createdAt']);
        allow delete: if isOwner(resource.data.userId) || isAdmin();
        allow update: if false;
      }
    }

    match /friendships/{friendshipId} {
      allow read: if isSignedIn() &&
        (resource.data.requesterId == request.auth.uid ||
         resource.data.addresseeId == request.auth.uid);
      allow create: if isOwner(request.resource.data.requesterId);
      allow update: if isSignedIn() &&
        (resource.data.requesterId == request.auth.uid ||
         resource.data.addresseeId == request.auth.uid);
      allow delete: if false;
    }

    // Reto criado pela treinadora no app. Os limites aqui são os mesmos do
    // formulário (ChallengeFormRules): XP entre 10 e 1000 para um reto não
    // valer mais que meses de treino no ranking nacional.
    function validChallenge(d) {
      return validText(d.title, 80) &&
        d.description is string && d.description.size() <= 500 &&
        d.metric in ['diasTreinados', 'checkIns', 'distanciaKm', 'pesoPerdidoKg', 'massaMuscularGanhaKg'] &&
        d.scope in ['individual', 'equipo', 'comunidad', 'regional'] &&
        d.period in ['semanal', 'mensal'] &&
        d.targetValue is number && d.targetValue > 0 && d.targetValue <= 10000 &&
        d.xpReward is int && d.xpReward >= 10 && d.xpReward <= 1000 &&
        d.startsAt is timestamp && d.endsAt is timestamp && d.endsAt > d.startsAt &&
        d.isActive is bool &&
        (d.get('rewardId', null) == null || rewardBelongsTo(d.rewardId, d.coachId));
    }

    function rewardBelongsTo(rewardId, coachId) {
      return get(/databases/$(database)/documents/rewards/$(rewardId)).data.coachId == coachId;
    }

    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create: if (isCoachOf(request.resource.data.coachId) || isAdmin()) &&
        validChallenge(request.resource.data) &&
        request.resource.data.participantCount == 0;
      // `participantCount` é do servidor (`onParticipantCreated`).
      allow update: if (isCoachOf(resource.data.coachId) || isAdmin()) &&
        validChallenge(request.resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['coachId', 'participantCount', 'createdAt']);
      allow delete: if isCoachOf(resource.data.coachId) || isAdmin();

      match /participants/{userId} {
        allow read: if isSignedIn();
        // Cliente só cria a inscrição inicial; progresso e conclusão são
        // calculados por Cloud Functions a partir de dados de origem
        // confiável (check-ins, treinos), nunca auto-declarados.
        allow create: if isOwner(userId) &&
          request.resource.data.currentValue == 0 &&
          request.resource.data.completed == false;
        allow update, delete: if false;
      }
    }

    match /championships/{championshipId} {
      allow read: if isSignedIn();
      allow create, update: if isCoachOf(request.resource.data.coachId) || isAdmin();
      allow delete: if isCoachOf(resource.data.coachId) || isAdmin();
    }

    function validReward(d) {
      return validText(d.name, 80) &&
        d.type in ['suplemento', 'vestuario', 'consultoria', 'mensalidadeGratis', 'acessorio', 'valeCompras'] &&
        d.stock is int && d.stock >= 0 && d.stock <= 1000 &&
        (d.get('imageUrl', null) == null || d.imageUrl is string);
    }

    // Prêmio cadastrado pela treinadora. O estoque só baixa pelo servidor
    // (`grantReward`), mas ela pode repor.
    match /rewards/{rewardId} {
      allow read: if isSignedIn();
      allow create: if (isCoachOf(request.resource.data.coachId) || isAdmin()) &&
        validReward(request.resource.data);
      allow update: if (isCoachOf(resource.data.coachId) || isAdmin()) &&
        validReward(request.resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coachId']);
      allow delete: if isCoachOf(resource.data.coachId) || isAdmin();

      match /grants/{grantId} {
        allow read: if isOwner(resource.data.userId) || isAdmin();
        allow write: if false; // Cloud Functions only
      }
    }

    match /rankings/{rankingId} {
      allow read: if isSignedIn();
      allow write: if false; // Cloud Functions only

      match /entries/{userId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false; // Cloud Functions only
    }

    match /gym_score_history/{entryId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false; // Cloud Functions only
    }

    match /seasons/{seasonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /results/{userId} {
        allow read: if isSignedIn();
        allow write: if false; // Cloud Function seasonReset only
      }
    }
  }
}
