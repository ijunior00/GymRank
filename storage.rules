rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function callerDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    // Treinadora dona de `coaches/{coachId}` (mesma regra do Firestore).
    function isCoachOf(coachId) {
      let doc = callerDoc();
      return isSignedIn() && coachId != null &&
        doc.role == 'coach' && ('coachId' in doc) && doc.coachId == coachId;
    }

    // Treinadora ou nutrióloga parceira da mesma comunidade.
    function isCoachStaffOf(coachId) {
      let doc = callerDoc();
      return isSignedIn() && coachId != null &&
        (doc.role == 'coach' || doc.role == 'nutriologo') &&
        ('coachId' in doc) && doc.coachId == coachId;
    }

    // Treinadora de uma aluna, lida do perfil dela (mesmo truque das
    // regras do Firestore para treinos/medidas/fotos).
    function coachIdOfUser(userId) {
      let u = firestore.get(/databases/(default)/documents/users/$(userId)).data;
      return ('coachId' in u) ? u.coachId : null;
    }

    function coachIdOfReward(rewardId) {
      return firestore.get(/databases/(default)/documents/rewards/$(rewardId)).data.coachId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // PDF, Word (.docx) ou imagem: os formatos aceitos para planos de
    // treino/dieta enviados pela treinadora ou pela nutrióloga.
    function isPlanDocument() {
      return request.resource.contentType == 'application/pdf' ||
        request.resource.contentType ==
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document' ||
        isImage();
    }

    // Fotos de evolução: só a própria aluna e o staff da comunidade dela.
    // Antes bastava estar logado — qualquer conta baixava a foto de
    // qualquer aluna.
    match /progress_photos/{userId}/{fileName} {
      allow read: if isOwner(userId) || isCoachStaffOf(coachIdOfUser(userId));
      allow write: if isOwner(userId) && isImage() &&
        request.resource.size < 10 * 1024 * 1024;
    }

    match /profile_photos/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isImage() &&
        request.resource.size < 5 * 1024 * 1024;
    }

    // Logo e imagens da marca da treinadora.
    match /coach_assets/{coachId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isCoachOf(coachId) && isImage() &&
        request.resource.size < 5 * 1024 * 1024;
    }

    // Documentos por aluno (PDF/Word/foto de dieta, macros, treino). Lidos
    // pelo aluno dono e pelo staff; escritos pela treinadora ou pela
    // nutrióloga. A Cloud Function `parseDocument` lê via Admin SDK.
    match /documents/{coachId}/{userId}/{fileName} {
      allow read: if isOwner(userId) || isCoachStaffOf(coachId);
      allow write: if isCoachStaffOf(coachId) && isPlanDocument() &&
        request.resource.size < 20 * 1024 * 1024;
    }

    // Imagem de um prêmio: só a treinadora dona do prêmio, com limite de
    // tamanho. Antes qualquer conta subia imagens sem limite aqui.
    match /reward_images/{rewardId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isCoachOf(coachIdOfReward(rewardId)) && isImage() &&
        request.resource.size < 5 * 1024 * 1024;
    }
  }
}
